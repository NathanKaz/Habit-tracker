{
  "name": "habit-tracker",
  "productName": "Трекер привычек",
  "version": "1.0.0",
  "description": "Трекер привычек с календарём, сериями и доступом с других устройств по локальной сети",
  "author": {
    "name": "Трекер привычек",
    "email": "noreply@example.com"
  },
  "homepage": "https://example.com/habit-tracker",
  "desktopName": "habit-tracker.desktop",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "cross-env HABIT_PORT=47821 concurrently -k -n vite,tsc,electron -c cyan,yellow,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "cross-env HABIT_PORT=47821 vite --host",
    "dev:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env HABIT_DEV=1 electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --linux",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  }
}
